<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Silmoon.Tools.Installer.WindowsMaker.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Silmoon.Tools.Installer.WindowsMaker" xmlns:vm="using:Silmoon.Tools.Installer.WindowsMaker.ViewModels">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <CommandBar Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" DefaultLabelPosition="Right">
            <AppBarButton x:Uid="NewButton" Icon="Add" Command="{x:Bind ViewModel.NewCommand}" AutomationProperties.AutomationId="NewButton"/>
            <AppBarButton x:Uid="OpenButton" Icon="OpenFile" Command="{x:Bind ViewModel.OpenCommand}" AutomationProperties.AutomationId="OpenButton"/>
            <AppBarButton x:Uid="SaveButton" Icon="Save" Command="{x:Bind ViewModel.SaveCommand}" AutomationProperties.AutomationId="SaveButton"/>
            <AppBarButton x:Uid="SaveAsButton" Icon="SaveLocal" Command="{x:Bind ViewModel.SaveAsCommand}" AutomationProperties.AutomationId="SaveAsButton"/>
            <AppBarSeparator/>
            <AppBarButton x:Uid="ValidateButton" Icon="Accept" Command="{x:Bind ViewModel.ValidateCommand}" AutomationProperties.AutomationId="ValidateButton"/>
            <AppBarButton x:Uid="BuildButton" Icon="Play" Command="{x:Bind ViewModel.BuildCommand}" Click="BuildClicked" AutomationProperties.AutomationId="BuildButton"/>
        </CommandBar>
        <Grid Grid.Row="1" Margin="24,4,24,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Uid="ConfigPath" Text="{x:Bind ViewModel.OpenPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ConfigPath"/>
            <Button x:Uid="OpenPathButton" Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.OpenPathCommand}" AutomationProperties.AutomationId="OpenPathButton"/>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="2" PaneDisplayMode="Left" OpenPaneLength="224" CompactPaneLength="48" IsSettingsVisible="False" IsBackButtonVisible="Collapsed" SelectionChanged="NavigationSelectionChanged" AutomationProperties.AutomationId="MainNavigation">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="NavFiles" x:Name="FilesNav" Icon="Folder" Tag="files" AutomationProperties.AutomationId="NavFiles"/>
                <NavigationViewItem x:Uid="NavProduct" Icon="Edit" Tag="product" AutomationProperties.AutomationId="NavProduct"/>
                <NavigationViewItem x:Uid="NavDependencies" Icon="Library" Tag="dependencies" AutomationProperties.AutomationId="NavDependencies"/>
                <NavigationViewItem x:Uid="NavDistribution" Icon="Globe" Tag="distribution" AutomationProperties.AutomationId="NavDistribution"/>
                <NavigationViewItem x:Uid="NavBuild" x:Name="BuildNav" Icon="Document" Tag="build" AutomationProperties.AutomationId="NavBuild"/>
            </NavigationView.MenuItems>
            <Grid Margin="24,8,24,16">
                <ScrollViewer IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" x:Name="FilesPanel" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="Label18" Style="{StaticResource TitleTextBlockStyle}"/>
                        <TextBlock x:Uid="Label19" TextWrapping="Wrap"/>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Uid="PublishDirectory" Text="{x:Bind ViewModel.PublishDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="PublishDirectory"/>
                            <Button x:Uid="BrowsePublish" Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BrowseCommand}" CommandParameter="publish" AutomationProperties.AutomationId="BrowsePublish" AutomationProperties.Name="选择 publish 目录"/>
                        </Grid>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Uid="MainExecutable" Text="{x:Bind ViewModel.MainExecutable, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="MainExecutable"/>
                            <Button x:Uid="BrowseMain" Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BrowseCommand}" CommandParameter="main" AutomationProperties.AutomationId="BrowseMain" AutomationProperties.Name="选择主程序"/>
                        </Grid>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Uid="OutputDirectory" Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="OutputDirectory"/>
                            <Button x:Uid="BrowseOutput" Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BrowseCommand}" CommandParameter="output" AutomationProperties.AutomationId="BrowseOutput" AutomationProperties.Name="选择输出目录"/>
                        </Grid>
                        <Button x:Uid="AnalyzeButton" Command="{x:Bind ViewModel.AnalyzeCommand}" AutomationProperties.AutomationId="AnalyzeButton"/>
                        <TextBlock x:Uid="Label32" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBox Text="{x:Bind ViewModel.AnalysisText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="420" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="AnalysisResults" AutomationProperties.Name="分析与验证结果"/>
                        <TextBox x:Uid="ProjectNotes" Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" AutomationProperties.AutomationId="ProjectNotes"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" x:Name="ProductPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="Label35" Style="{StaticResource TitleTextBlockStyle}"/>
                        <InfoBar x:Uid="Label36" IsOpen="True" IsClosable="False" Severity="Informational"/>
                        <Grid ColumnSpacing="16" RowSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBox x:Uid="ProductId" Text="{x:Bind ViewModel.ProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ProductId"/>
                            <TextBox x:Uid="DisplayName" Grid.Column="1" Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="DisplayName"/>
                            <TextBox x:Uid="Publisher" Grid.Row="1" Text="{x:Bind ViewModel.Publisher, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Publisher"/>
                            <TextBox x:Uid="Version" Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Version, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Version"/>
                            <ComboBox x:Uid="Architecture" Grid.Row="2" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.ArchitectureLabels, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.ArchitectureIndex, Mode=TwoWay}" AutomationProperties.AutomationId="Architecture"/>
                            <TextBox x:Uid="Channel" Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Channel"/>
                        </Grid>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Uid="IconPath" Text="{x:Bind ViewModel.IconPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="IconPath"/>
                            <Button x:Uid="BrowseIcon" Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BrowseCommand}" CommandParameter="icon" AutomationProperties.AutomationId="BrowseIcon" AutomationProperties.Name="选择图标"/>
                        </Grid>
                        <CheckBox x:Uid="DesktopShortcut" IsChecked="{x:Bind ViewModel.DesktopShortcut, Mode=TwoWay}" AutomationProperties.AutomationId="DesktopShortcut"/>
                        <CheckBox x:Uid="StartMenuShortcut" IsChecked="{x:Bind ViewModel.StartMenuShortcut, Mode=TwoWay}" AutomationProperties.AutomationId="StartMenuShortcut"/>
                        <ComboBox x:Uid="InstallScope" ItemsSource="{x:Bind ViewModel.InstallScopeLabels, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.InstallScopeIndex, Mode=TwoWay}" AutomationProperties.AutomationId="InstallScope"/>
                        <TextBlock x:Uid="Label49" TextWrapping="Wrap"/>
                        <TextBox x:Uid="ExpectedVelopackVersion" Text="{x:Bind ViewModel.ExpectedVelopackVersion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ExpectedVelopackVersion"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" x:Name="DependenciesPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="Label52" Style="{StaticResource TitleTextBlockStyle}"/>
                        <InfoBar x:Uid="Label53" IsOpen="True" IsClosable="False" Severity="Warning"/>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Uid="DependencyKind" ItemsSource="{x:Bind ViewModel.NewDependencyKindLabels, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.NewDependencyKindIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DependencyKind"/>
                            <ComboBox x:Uid="DependencyDelivery" Grid.Column="1" ItemsSource="{x:Bind ViewModel.NewDependencyDeliveryLabels, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.NewDependencyDeliveryIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="DependencyDelivery"/>
                            <Button x:Uid="AddDependency" Grid.Column="2" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.AddDependencyCommand}" AutomationProperties.AutomationId="AddDependency"/>
                        </Grid>
                        <ListView ItemsSource="{x:Bind ViewModel.DependencySummary, Mode=OneWay}" MaxHeight="140" SelectionMode="None" AutomationProperties.AutomationId="DependencyList" AutomationProperties.Name="已配置的依赖"/>
                        <TextBlock x:Uid="Label59" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock x:Uid="Label60" TextWrapping="Wrap"/>
                        <TextBox Text="{x:Bind ViewModel.DependenciesJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="320" MaxHeight="520" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="DependenciesJson" AutomationProperties.Name="依赖 JSON 定义"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Uid="ApplyDependencies" Command="{x:Bind ViewModel.ApplyDependenciesCommand}" AutomationProperties.AutomationId="ApplyDependencies"/>
                            <Button x:Uid="BrowseDependency" Command="{x:Bind ViewModel.BrowseCommand}" CommandParameter="dependency" AutomationProperties.AutomationId="BrowseDependency"/>
                        </StackPanel>
                        <TextBlock x:Uid="Label62" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" x:Name="DistributionPanel" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="16">
                        <TextBlock x:Uid="Label65" Style="{StaticResource TitleTextBlockStyle}"/>
                        <ComboBox x:Uid="DistributionMode" ItemsSource="{x:Bind ViewModel.DistributionModeLabels, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.DistributionModeIndex, Mode=TwoWay}" AutomationProperties.AutomationId="DistributionMode"/>
                        <TextBlock x:Uid="Label66" TextWrapping="Wrap"/>
                        <TextBox x:Uid="UpdateUrl" Text="{x:Bind ViewModel.UpdateUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="UpdateUrl"/>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Uid="ReleaseNotesPath" Text="{x:Bind ViewModel.ReleaseNotesPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="ReleaseNotesPath"/>
                            <Button x:Uid="BrowseReleaseNotes" Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BrowseCommand}" CommandParameter="notes" AutomationProperties.AutomationId="BrowseReleaseNotes" AutomationProperties.Name="选择版本说明"/>
                        </Grid>
                        <CheckBox x:Uid="GenerateDelta" IsChecked="{x:Bind ViewModel.GenerateDelta, Mode=TwoWay}" AutomationProperties.AutomationId="GenerateDelta"/>
                        <ComboBox x:Uid="SigningMode" ItemsSource="{x:Bind ViewModel.SigningModeLabels, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SigningModeIndex, Mode=TwoWay}" AutomationProperties.AutomationId="SigningMode"/>
                        <TextBlock x:Uid="Label71" TextWrapping="Wrap"/>
                        <CheckBox x:Uid="PreserveUserData" IsChecked="{x:Bind ViewModel.PreserveUserData, Mode=TwoWay}" AutomationProperties.AutomationId="PreserveUserData"/>
                        <InfoBar x:Uid="Label72" IsOpen="True" IsClosable="False" Severity="Informational"/>
                        <TextBlock x:Uid="Label73" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="BuildPanel" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="160"/></Grid.RowDefinitions>
                    <TextBlock x:Uid="Label82" Style="{StaticResource TitleTextBlockStyle}"/>
                    <Grid Grid.Row="1" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{x:Bind ViewModel.BuildStage, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" AutomationProperties.AutomationId="BuildStatus"/><TextBlock Text="{x:Bind ViewModel.ExitCodeText, Mode=OneWay}" AutomationProperties.Name="退出码"/></StackPanel>
                        <Button x:Uid="CancelBuildButton" Grid.Column="1" Command="{x:Bind ViewModel.CancelBuildCommand}" AutomationProperties.AutomationId="CancelBuildButton"/>
                        <Button x:Uid="OpenOutputButton" Grid.Column="2" Command="{x:Bind ViewModel.OpenOutputCommand}" AutomationProperties.AutomationId="OpenOutputButton"/>
                    </Grid>
                    <ProgressBar Grid.Row="2" Value="{x:Bind ViewModel.BuildPercent, Mode=OneWay}" IsIndeterminate="{x:Bind ViewModel.ProgressIndeterminate, Mode=OneWay}" Minimum="0" Maximum="100" AutomationProperties.Name="构建进度"/>
                    <TextBox Grid.Row="3" Text="{x:Bind ViewModel.BuildLog, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="BuildLog" AutomationProperties.Name="构建日志"/>
                    <TextBox x:Uid="SetupPath" Grid.Row="4" Text="{x:Bind ViewModel.SetupPath, Mode=OneWay}" IsReadOnly="True" AutomationProperties.AutomationId="SetupPath"/>
                    <ListView Grid.Row="5" ItemsSource="{x:Bind ViewModel.Artifacts, Mode=OneWay}" SelectionMode="None" AutomationProperties.AutomationId="ArtifactList" AutomationProperties.Name="构建产物与 SHA256"><ListView.ItemTemplate><DataTemplate x:DataType="x:String"><TextBlock Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></DataTemplate></ListView.ItemTemplate></ListView>
                </Grid>
            </Grid>
        </NavigationView>
        <Grid Grid.Row="3" Margin="24,0,24,12" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <InfoBar IsOpen="True" IsClosable="False" Message="{x:Bind ViewModel.Status, Mode=OneWay}" Severity="{x:Bind local:MainPage.StatusSeverity(ViewModel.IsError), Mode=OneWay}" AutomationProperties.AutomationId="StatusMessage"/>
            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DocumentState, Mode=OneWay}" VerticalAlignment="Center" AutomationProperties.AutomationId="DocumentState"/>
        </Grid>
    </Grid>
</Page>
